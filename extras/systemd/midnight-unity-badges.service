[Unit]
Description=Midnight Dock: unread-count badges (Unity LauncherEntry bridge)
PartOf=graphical-session.target
After=plasma-plasmashell.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 %h/.local/share/plasma/plasmoids/dev.jacoblewis.midnightdock/tools/unity-badge-daemon.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
