<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">
  <kcfgfile name=""/>
  <group name="General">
    <!-- Defaults match what the widget hardcoded before it had a config page,
         so existing installs render identically until something is changed. -->
    <entry name="zip" type="String">
      <default></default>
    </entry>
    <entry name="latitude" type="Double">
      <default>51.5074</default>
    </entry>
    <entry name="longitude" type="Double">
      <default>-0.1278</default>
    </entry>
    <entry name="placeLabel" type="String">
      <default>London</default>
    </entry>
    <entry name="metric" type="Bool">
      <default>false</default>
    </entry>
  </group>
</kcfg>
